# Copy this file to ".env" (same folder) and edit if needed.
# All values below are the defaults used when .env is absent.

# Frontend origins allowed to call the API (comma-separated, no spaces needed)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Paths are relative to the backend/ folder
DATA_PATH=data/raw/diabetes.csv
MODELS_DIR=models
OUTPUTS_DIR=../outputs
